# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Cloudflare R2 Storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=scenenode-assets
R2_PUBLIC_URL=https://assets.nodaro.ai

# AI Providers
REPLICATE_API_TOKEN=r8_xxxxx
KIE_API_KEY=your_kie_api_key
ANTHROPIC_API_KEY=sk-ant-xxxxx
ELEVENLABS_API_KEY=xxxxx
APIFY_API_TOKEN=apify_api_xxxxx
# Google Gemini API key — https://aistudio.google.com/apikey
# Enables the direct-Google lane for Gemini models. Optional: when empty every
# Gemini model stays on KIE. NOT the same as GOOGLE_CLIENT_ID/SECRET (OAuth).
# Kept LAST in this block and left EMPTY on purpose: gitleaks' generic-api-key
# rule pairs a key-shaped NAME with the next value it can find, so an empty
# value directly above another KEY=placeholder line matches across the newline
# and captures that placeholder as a secret — which blocked the npm publish on
# the public mirror (2026-07-28). Empty is the meaningful default (every Gemini
# model stays on KIE), so the fix is ordering, not a fake placeholder.
GEMINI_API_KEY=

# Edition (community, business, or cloud)
EDITION=community

# Stripe Billing (cloud edition only)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:3000

# Social Media OAuth (optional)
SOCIAL_ENCRYPTION_KEY=
# META_APP_ID=
# META_APP_SECRET=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# Server
PORT=8000
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:8000

# Shared secret for internal orchestrator → API auth. Required.
# Generate: `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
INTERNAL_ORCHESTRATOR_SECRET=
