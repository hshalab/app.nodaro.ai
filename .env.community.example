# Nodaro self-host — example .env for docker-compose.community.yml
# Copy to .env in this directory, then: docker compose -f docker-compose.community.yml up -d
#
# Everything is OPTIONAL for local play — the compose file has working defaults.
#
# SECURITY — before exposing this stack to a network, replace the default
# JWT/anon/service keys (the defaults are public knowledge by definition):
#     node tools/generate-selfhost-keys.mjs >> .env

# ── Provider keys ─────────────────────────────────────────────────────────
# nodaro.ai models need NO key here — click "Connect nodaro.ai" in the app
# instead (OAuth sign-in; 1,500 free credits on a new account).

# KIE_API_KEY=             # kie.ai — broadest media-model coverage
# REPLICATE_API_TOKEN=     # replicate.com
# ANTHROPIC_API_KEY=       # console.anthropic.com — LLM nodes
# GEMINI_API_KEY=          # aistudio.google.com — LLM + video analysis
# ELEVENLABS_API_KEY=      # elevenlabs.io — speech + voice
# FAL_KEY=                 # fal.ai

# ── Optional overrides ────────────────────────────────────────────────────
# PUBLIC_URL=http://localhost:3000    # change if serving on another host/port
# NODARO_CLOUD_URL=https://app.nodaro.ai
